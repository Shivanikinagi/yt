# ---- Tech Shorts Factory: environment template ----
# Copy to .env (never commit .env). In GitHub Actions, set these as repository Secrets.

# LLM providers (all optional; the pipeline falls back to the template writer with none)
# Local Ollama (free, runs on your PC): no key needed, just OLLAMA_HOST if not default
OLLAMA_HOST=http://localhost:11434
# GitHub Models (free tier). Locally: a fine-grained PAT with "Models: read".
# In GitHub Actions the built-in GITHUB_TOKEN works when the workflow has `models: read`.
GITHUB_TOKEN=
# Groq free tier: https://console.groq.com
GROQ_API_KEY=
# Google AI Studio free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (use a model with the :free suffix): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# YouTube Data API v3 (OAuth installed-app client). Create at https://console.cloud.google.com
# Download the client JSON, save it as secrets/youtube_client_secret.json (local),
# or paste its contents into this variable (CI).
YOUTUBE_CLIENT_SECRET_JSON=
# Produced by `python -m shorts_factory auth`. Paste the printed value here for CI.
YOUTUBE_TOKEN_JSON=

# Safety switch: public scheduling is refused unless this is exactly "true"
ALLOW_PUBLIC_SCHEDULING=false

# Optional overrides
# SHORTS_DAILY_TARGET=5
# SHORTS_MAX_RUNTIME_MINUTES=115
# SHORTS_TTS_ENGINES=piper,edge,sapi
